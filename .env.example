# IGRS Telangana AI Chatbot - Environment Variables
# Copy this file to .env.local and fill in your actual values

# Backend API URL (ngrok tunnel or deployed backend)
NEXT_PUBLIC_BACKEND_URL=https://xxxx.ngrok-free.app

# Calendly booking URL
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/yourname/demo

# Brevo (Sendinblue) API Key for email integration
# Get this from: https://app.brevo.com/settings/keys/api
NEXT_PUBLIC_BREVO_API_KEY=your_brevo_api_key_here
NEXT_PUBLIC_BREVO_API_URL="https://api.brevo.com/v3/contacts"

# Google reCAPTCHA Site Key (for form protection)
# Get this from: https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# Developer/Recruiter Contact Information
# Email address where recruitment notifications will be sent
NEXT_PUBLIC_DEV_EMAIL=recruiter@company.com

# Professional Links (for recruiter email)
NEXT_PUBLIC_RESUME_URL=https://drive.google.com/your-resume-link
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/in/yourprofile
NEXT_PUBLIC_GITHUB_URL=https://github.com/yourusername

